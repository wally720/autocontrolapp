{
  "name": "autogasto-pro",
  "private": true,
  "version": "1.7.2",
  "homepage": "https://autogastopro.cc",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test 'src/**/*.test.js'",
    "test:rules": "firebase emulators:exec --only firestore --project gastos-auto-test 'node --test firestore.rules.test.js'",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.7.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "firebase-tools": "^15.27.0",
    "gh-pages": "^6.3.0",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "protobufjs@7.6.5": true,
    "fsevents@2.3.3": true,
    "firebase@12.17.1": true,
    "@firebase/util@1.15.2": true
  }
}
